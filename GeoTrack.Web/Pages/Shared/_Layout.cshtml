<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - GeoTrack</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="topbar">
        <div class="container bar">
            <a class="brand" asp-page="/Index"><span class="brand-mark" aria-hidden="true">G</span><span>GeoTrack</span></a>
            <nav class="nav" aria-label="Ana menü">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-page="/Index">Panel</a>
                    <a asp-page="/Incidents/Index">Olaylar</a>
                    <a asp-page="/Incidents/Map">Harita</a>
                    <a asp-page="/Search/Index">Arama</a>
                    <a asp-page="/Analytics/Index">Analitik</a>
                    <a asp-page="/Notifications/Index" class="notification-nav" aria-label="Bildirimler">
                        <span aria-hidden="true">🔔</span> Bildirimler
                        <span id="notification-unread-count" class="notification-count" aria-live="polite" hidden></span>
                    </a>
                    @if (User.IsInRole("Admin")) { <a asp-page="/Admin/Index">Yönetim</a> }
                    <a class="btn primary" asp-page="/Incidents/Create">+ Yeni olay</a>
                    <form method="post" asp-page="/Account/Logout"><button type="submit">Çıkış</button></form>
                }
                else
                {
                    <a asp-page="/Account/Login">Giriş</a>
                    <a asp-page="/Account/Register">Kayıt ol</a>
                }
            </nav>
        </div>
    </header>

    <main class="container">
        @if (TempData["Success"] is string success)
        {
            <div class="alert success" role="status">@success</div>
        }
        @if (TempData["Error"] is string pageError)
        {
            <div class="alert error" role="alert">@pageError</div>
        }
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">GeoTrack - Akıllı Arıza ve Saha Operasyon Yönetimi (MVP / demo uygulaması)</div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="~/js/navigation.js" asp-append-version="true"></script>
    }
</body>
</html>
