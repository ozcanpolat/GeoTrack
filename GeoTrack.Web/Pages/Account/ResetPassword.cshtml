@page
@model GeoTrack.Web.Pages.Account.ResetPasswordModel
@{ ViewData["Title"] = "Yeni parola"; }
<section class="panel auth-panel"><span class="eyebrow">Hesap kurtarma</span><h1>Yeni parola belirleyin</h1>
@if (Model.Completed)
{
    <div class="alert success" role="status">Parolanız yenilendi. Tüm önceki JWT oturumları geçersiz kılındı.</div><a class="btn primary" asp-page="Login">Giriş yap</a>
}
else
{
    <form method="post" class="form"><input asp-for="Email" type="hidden" /><input asp-for="Code" type="hidden" />
        <div class="field"><label asp-for="Password">Yeni parola · en az 12 karakter</label><input asp-for="Password" type="password" autocomplete="new-password" required minlength="12" /></div>
        <div class="field"><label asp-for="ConfirmPassword">Yeni parolayı doğrulayın</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required minlength="12" /></div>
        @foreach (var error in Model.Errors) { <div class="alert error" role="alert">@error</div> }
        <button class="btn primary" type="submit">Parolayı güncelle</button>
    </form>
}
</section>
