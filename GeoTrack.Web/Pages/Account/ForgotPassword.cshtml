@page
@model GeoTrack.Web.Pages.Account.ForgotPasswordModel
@{ ViewData["Title"] = "Parola yenileme"; }
<section class="panel auth-panel"><span class="eyebrow">Hesap kurtarma</span><h1>Parolanızı yenileyin</h1>
@if (Model.Submitted)
{
    <div class="alert info" role="status">Adres kayıtlıysa parola yenileme yönergeleri e-posta ile gönderilir.</div>
}
else
{
    <p class="muted">Hesabınıza bağlı e-posta adresini girin.</p>
    <form method="post" class="form"><div class="field"><label asp-for="Email">E-posta</label><input asp-for="Email" type="email" autocomplete="email" required /></div>
        <span asp-validation-for="Email" class="field-error"></span><button class="btn primary" type="submit">Yenileme bağlantısı gönder</button>
    </form>
}
<p class="auth-links"><a asp-page="Login">Giriş sayfasına dön</a></p></section>
