@page
@model GeoTrack.Web.Pages.ErrorModel
@{
    ViewData["Title"] = "Hata";
}

<h1>Bir hata oluştu</h1>
<p>İşleminiz tamamlanamadı. Lütfen daha sonra tekrar deneyin.</p>
