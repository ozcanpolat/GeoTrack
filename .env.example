# Kopyalayın: copy .env.example .env   (.env Git'e eklenmez)
# Bunlar yalnızca YEREL GELİŞTİRME değerleridir.
POSTGRES_DB=geotrack
POSTGRES_USER=geotrack
POSTGRES_PASSWORD=geotrack_dev_password
POSTGRES_PORT=5432
WEB_PORT=8080

# İsteğe bağlı AI (Anthropic). İkisi de doluysa etkinleşir; boşsa "yapılandırılmadı" olarak kalır.
# Gerçek anahtarı yalnızca kendi .env dosyanıza yazın, bu örnek dosyaya ASLA yazmayın.
AI_API_KEY=
AI_MODEL=
