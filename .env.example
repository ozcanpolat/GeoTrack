# Kopyalayın: copy .env.example .env   (.env Git'e eklenmez; gerçek değerleri YALNIZCA orada tutun)
# Değişiklikten sonra: docker compose up -d --force-recreate web

# --- Veritabanı ---
POSTGRES_DB=geotrack
POSTGRES_USER=geotrack
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
WEB_PORT=8080

# --- Uygulama ---
# Açılışta EF migration'larını uygula (tek örnekli Compose için uygundur; çok örnekli/üretimde false yapıp migration'ı ayrı çalıştırın).
APPLY_MIGRATIONS=true
# Yalnızca demo/geliştirme: tablo boşsa örnek olaylar ekler. Üretimde false bırakın.
SEED_DEMO_DATA=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# En az 32 karakter, benzersiz ve rastgele. Doğrulama kodu özetlerinde de anahtar olarak kullanılır.
JWT_SIGNING_KEY=
# E-postadaki bağlantıların ve kullanıcıların eriştiği adres
PUBLIC_BASE_URL=http://localhost:8080

# --- E-posta: SEÇENEK A — Gmail (gerçek gönderim, varsayılan) ---
# 1) Google Hesabı > Güvenlik > 2 Adımlı Doğrulama'yı açın
# 2) Güvenlik > "Uygulama şifreleri" ile 16 haneli şifre üretin (boşluksuz da girilebilir)
# STARTTLS (587) kullanılır; SMTP_USE_SSL=false bu yüzden doğrudur. Kullanıcı adı doluysa şifreleme otomatik açılır.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=GeoTrack

# --- E-posta: SEÇENEK B — smtp4dev (yalnızca yerel test, gerçek e-posta GİTMEZ) ---
# Yukarıdaki Gmail değerleri yerine şunları kullanın ve servisi başlatın:
#   SMTP_HOST=smtp4dev  SMTP_PORT=25  SMTP_USERNAME=  SMTP_PASSWORD=  SMTP_FROM_EMAIL=noreply@geotrack.local
#   docker compose --profile smtp4dev up -d
# Gelen kutusu: http://localhost:8025
SMTP4DEV_WEB_PORT=8025

# --- İsteğe bağlı AI önerisi (Anthropic) ---
# AI_API_KEY boşsa özellik kapalıdır; kayıt oluşturmayı engellemez (yönetici logunda uyarı yazılır).
# AI_MODEL boşsa varsayılan model kullanılır.
AI_API_KEY=
AI_MODEL=

# --- Harita ---
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
